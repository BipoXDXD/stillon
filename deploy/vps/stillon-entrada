#!/usr/bin/env bash
# stillon-entrada: a ÚNICA coisa que a chave de deploy alcança na VPS (Plano
# 11, spec §3). Instalado em /usr/local/sbin/stillon-entrada (root, 755). O
# authorized_keys do usuário deploy força:
#
#   restrict,command="sudo /usr/local/sbin/stillon-entrada" ssh-ed25519 ...
#
# e o sudoers (deploy/vps/sudoers-stillon-entrada) deixa o deploy rodar só
# este arquivo, sem argumento, guardando o SSH_ORIGINAL_COMMAND. O pedido vem
# do SSH_ORIGINAL_COMMAND, e nunca da linha de comando:
#
#   ssh deploy@VPS "deploy <sha 40 hex> <image-id sha256:64 hex>" < imagem.tar
#       O tar (layout OCI, sem nome) chega pela entrada padrão. Códigos: 0
#       deploy saudável; 2 pedido recusado (uso, argumento); 3 imagem
#       divergente (o ID carregado não é o pedido, ou o tar traz nome, ou foge
#       do layout OCI do crane); 4 não ficou saudável e o rollback foi feito
#       (ou, no primeiro deploy, sem anterior, o app foi parado e removido);
#       1 qualquer outro erro. Precisa do jq na VPS (docs/deploy/vps.md).
#
#   ssh deploy@VPS backup > stillon-<data>.dump.age
#       O dump do banco, restaurado e conferido pelo deploy/backup/backup.sh
#       supervisionado, cifrado com a chave PÚBLICA do age em
#       /opt/stillon/age-recipient, na saída padrão; o log na de erro.
#       Códigos: 0 conferido; 3 a cópia não passou nas checagens (nada na
#       saída); 4 conferido e enviado, mas o disco passou de 85%; 1 outro
#       erro (nada, ou um cifrado incompleto, na saída: descarte).
#       Os scripts ficam em /opt/stillon/deploy/, com o layout do
#       repositório (backup/backup.sh, backup/verificar.sql,
#       compose/initdb.sql), porque o backup.sh acha o initdb.sql por
#       ../compose/.
#
# Tudo o que o script escreve vai para a saída de ERRO: a saída padrão fica
# reservada (o verbo backup manda por ela só o dump cifrado). Depois da trava,
# esse log vai também para /opt/stillon/entrada.log (0644, rodado para
# entrada.log.1 acima de 1 MiB), por um tee que sobrevive à queda do SSH: se
# o runner some no meio de um deploy, a entrada termina o deploy (ou o
# rollback) mesmo assim, e o dono confere em /opt/stillon/versao e no log.
#
# Sem variável de ambiente que mude o comportamento: o sudo limpa o ambiente
# (sobram TERM, HOME, SHELL e as de idioma, LANG e LC_*), e os caminhos abaixo
# são constantes. Mesmo assim, o idioma é fixado e as variáveis do docker e do
# compose saem, por defesa. O teste do CI (deploy/ci/checar-vps.sh) roda uma
# cópia com estas constantes trocadas por sed.
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
for v in $(compgen -e); do
    case "$v" in DOCKER_* | COMPOSE_*) unset "$v" ;; esac
done

DIR=/opt/stillon
IMAGEM=stillon
ARQUIVOS_COMPOSE="$DIR/compose.prod.yaml"
ESPERA_S=90
# O tar do deploy é recebido, extraído e refeito aqui (o mesmo disco das
# imagens): cabe até 3 vezes o TETO_BYTES durante o deploy.
TMP_BASE=$DIR
SHM_BASE=/dev/shm
SCRIPTS="$DIR/deploy"
TETO_BYTES=$((2 * 1024 * 1024 * 1024))
# Linhas do historico que ficam depois de cada deploy (a poda só usa as 3
# últimas versões distintas).
HISTORICO_MAX=50
# Acima disto, o entrada.log vira entrada.log.1 (a anterior sai).
LOG_TETO=$((1024 * 1024))

# fd 3 = a saída padrão de verdade; daqui em diante, o que não for o dump
# cifrado vai para a de erro.
exec 3>&1 1>&2

sair() {
    local codigo=$1
    shift
    echo "stillon-entrada: $*"
    exit "$codigo"
}
uso() { sair 2 "$* (uso: \"deploy <sha de 40 hex> sha256:<64 hex>\" ou \"backup\")"; }

# O que o EXIT apaga: fixado por quem cria (deploy e backup), vazio antes.
TMP_DEPLOY=
TMP_BACKUP=
RESTAURO=
HELPER=
TMP_HELPER=
TEE_PID=
PEDIDO=
# shellcheck disable=SC2317,SC2329 # chamada pelo trap EXIT (0.9 e 0.10+ dão códigos diferentes)
fim() {
    local codigo=$? sentido
    [ -z "$TMP_DEPLOY" ] || rm -rf "$TMP_DEPLOY"
    # Com -v: um volume anônimo do descartável (o VOLUME da imagem do
    # postgres, se um dia o --tmpfs não o cobrir) sai junto, e não sobra um
    # por backup.
    [ -z "$HELPER" ] || remover_recurso_backup "$HELPER" helper || true
    [ -z "$TMP_HELPER" ] || rm -rf "$TMP_HELPER"
    if [ -n "$RESTAURO" ]; then
        limpar_dump_restauro "$RESTAURO" || true
        remover_recurso_backup "$RESTAURO" restauro || true
    fi
    if [ -n "$TMP_BACKUP" ]; then
        shred -u "$TMP_BACKUP"/* 2>/dev/null || true
        rm -rf "$TMP_BACKUP"
    fi
    # A linha final do entrada.log, com o resultado: é ela que o dono lê
    # depois de uma queda do SSH. O tee termina de gravar antes de a entrada
    # sair: fechar as duas saídas dá a ele o fim do pipe.
    if [ -n "$TEE_PID" ]; then
        case "$PEDIDO:$codigo" in
            *:0) sentido="feito" ;;
            *:2) sentido="pedido recusado" ;;
            deploy*:3) sentido="imagem recusada; nada mudou" ;;
            deploy*:4) sentido="não ficou saudável; rollback feito, ou app parado no primeiro deploy" ;;
            backup*:3) sentido="a cópia não passou nas checagens; nada enviado" ;;
            backup*:4) sentido="enviado, mas o disco passou de 85%" ;;
            *) sentido="erro; veja as linhas acima" ;;
        esac
        echo "== $(date -u +%Y-%m-%dT%H:%M:%SZ) fim: $PEDIDO: código $codigo ($sentido)"
        exec 1>&- 2>&-
        wait "$TEE_PID" 2>/dev/null || true
    fi
    exit "$codigo"
}
trap fim EXIT

# registrar: chamado logo depois da trava, nos dois verbos. O log (fd 1 e 2)
# passa por um tee que grava no entrada.log e repassa à stderr do SSH. Com
# -p, o tee ignora o pipe quebrado (a conexão que caiu) e segue gravando no
# arquivo; SIGPIPE e SIGHUP ignorados aqui valem para a entrada e para os
# filhos (docker compose, docker), que só escrevem no tee. A fd 3 (a saída
# padrão de verdade, o cifrado do backup) e a 9 (a trava) não passam pelo
# tee: o tee as fecha.
registrar() {
    local log="$DIR/entrada.log"
    if [ -f "$log" ] && [ "$(stat -c %s "$log")" -gt "$LOG_TETO" ]; then
        mv -f "$log" "$log.1"
    fi
    : >>"$log"
    chmod 644 "$log"
    trap '' PIPE HUP
    exec 1> >(exec tee -p -a "$log" >&2 3>&- 9>&-) 2>&1
    TEE_PID=$!
    PEDIDO=$1
    echo "== $(date -u +%Y-%m-%dT%H:%M:%SZ) início: $PEDIDO"
}

dc() { COMPOSE_FILE="$ARQUIVOS_COMPOSE" docker compose --project-directory "$DIR" "$@"; }

# conteineres <servico>: os IDs dos contêineres do serviço, em qualquer
# estado, pelos rótulos do compose e sem os one-off (um `compose run` que
# sobrou não é o serviço). O `dc ps -a` os incluiria. PROJETO vem do deploy.
PROJETO=
conteineres() {
    docker ps -aq --filter "label=com.docker.compose.project=$PROJETO" \
        --filter "label=com.docker.compose.service=$1" --filter label=com.docker.compose.oneoff=False
}

# subir <sha> <id>: sobe a pilha com a versão <sha> e sai 0 só se ela ficou
# saudável, conferida AQUI, e não pelo código do `up --wait`: o docker compose
# até a v5.5.0 sai 0 quando o --wait-timeout vence com um contêiner ainda em
# `starting` (o laço da espera volta sem erro quando o prazo acaba, numa
# corrida com o tique de 500 ms; corrigido na v5.5.1). Saudável: cada serviço
# com um contêiner só, `running` (nunca `restarting`), `healthy` onde há
# healthcheck, e o do app com a etiqueta $IMAGEM:<sha> e o image-id <id> (o
# contêiner criado para esta versão, e não um que sobrou). Um `starting`
# segue esperando até ESPERA_S depois do início do `up`; depois disso, falha.
subir() {
    local sha=$1 id=$2 prazo servicos s ctr status saude imagem imagem_id pronto
    prazo=$(($(date +%s) + ESPERA_S))
    STILLON_SHA=$sha dc up -d --wait --wait-timeout "$ESPERA_S" || return 1
    servicos=$(STILLON_SHA=$sha dc config --services) || return 1
    while :; do
        pronto=1
        for s in $servicos; do
            ctr=$(conteineres "$s") || return 1
            if [ -z "$ctr" ] || [ "$(wc -l <<<"$ctr")" -ne 1 ]; then
                echo "o serviço $s tem $(grep -c . <<<"$ctr") contêineres, e não 1"
                return 1
            fi
            read -r status saude imagem imagem_id < <(docker inspect -f \
                '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}} {{.Config.Image}} {{.Image}}' "$ctr") ||
                return 1
            if [ "$s" = app ] && { [ "$imagem" != "$IMAGEM:$sha" ] || [ "$imagem_id" != "$id" ]; }; then
                echo "o app roda $imagem ($imagem_id), e não $IMAGEM:$sha ($id)"
                return 1
            fi
            if [ "$status" != running ]; then
                echo "o $s está $status"
                return 1
            fi
            case "$saude" in
                healthy | -) ;;
                starting) pronto=0 ;;
                *)
                    echo "o $s está $saude"
                    return 1
                    ;;
            esac
        done
        [ "$pronto" = 0 ] || return 0
        if [ "$(date +%s)" -ge "$prazo" ]; then
            echo "o up saiu, mas a pilha segue em starting depois de ${ESPERA_S} s"
            return 1
        fi
        sleep 1
    done
}

# O ID que o deploy.yml manda é o digest do manifesto linux/amd64, e só o
# image store containerd devolve esse valor no `docker load` e no `.Id` (no
# store clássico, o ID é o da config). Com o outro store, a conferência
# recusaria todo deploy: melhor dizer por quê.
exigir_containerd() {
    local drivers
    drivers=$(docker info -f '{{.DriverStatus}}' 2>/dev/null || true)
    [[ "$drivers" == *io.containerd.snapshotter.v1* ]] ||
        sair 1 "o Docker não usa o image store containerd; veja docs/deploy/vps.md (Docker)"
}

# Mantém as imagens das 3 últimas versões que ficaram no ar (o historico,
# uma linha por deploy saudável); as outras etiquetas $IMAGEM:<sha> saem,
# inclusive as de deploys que não ficaram saudáveis. Uma em uso não sai (o rmi
# recusa) e não é erro. Sem `head` no pipe: sob pipefail, o SIGPIPE do awk
# derrubaria a entrada com 141 quando o historico crescesse.
podar() {
    local manter tag
    manter=$(tac "$DIR/historico" | awk '!visto[$0]++ && n++ < 3')
    while read -r tag; do
        [ "$tag" = atual ] && continue
        grep -qxF -- "$tag" <<<"$manter" && continue
        docker rmi "$IMAGEM:$tag" >/dev/null 2>&1 || true
    done < <(docker image ls "$IMAGEM" --format '{{.Tag}}')
}

# O tar do deploy.yml é o layout OCI do `crane pull --format oci`, empacotado
# com `tar -C dir -cf - .`: oci-layout, index.json e blobs/sha256/<digest>,
# com ou sem o "./" na frente. Um tar com nome etiquetaria, no load, uma
# imagem qualquer desta máquina (stillon:atual, caddy:2) antes de qualquer
# conferência. Por isso o tar não é lido como texto: é extraído em $1/x (só
# arquivos e diretórios, só esses nomes, sem repetição), o index.json é
# conferido por um parser de JSON (uma imagem, o digest pedido, sem anotação
# nenhuma), e o que o load recebe é um tar REFEITO a partir de $1/x: o
# conferido é exatamente o carregado. Sai 3 em qualquer desvio.
conferir_tar() {
    local dir=$1 id=$2 membros
    # Tipo (a 1ª letra), tamanho (o 3º campo, com o dono numérico e sem
    # espaço) e nome (o último) de cada membro: diretório só a raiz, blobs e
    # blobs/sha256; o resto, arquivo comum. Um blobs que fosse arquivo faria o
    # tar -x falhar lá embaixo, como se fosse a máquina. O total extraído
    # também cabe no teto.
    membros=$(tar -tvf "$dir/imagem.tar" --numeric-owner 2>/dev/null) ||
        sair 3 "o que chegou não é um tar legível"
    awk -v teto="$TETO_BYTES" '
        {
            tipo = substr($0, 1, 1)
            nome = $NF
            sub(/^\.\//, "", nome)
            sub(/\/$/, "", nome)
            dir = (nome == "" || nome == "." || nome == "blobs" || nome == "blobs/sha256")
            if ((dir && tipo != "d") || (!dir && tipo != "-")) exit 1
            total += $3
        }
        END { if (total > teto) exit 1 }' <<<"$membros" ||
        sair 3 "o tar traz membro de tipo inesperado (diretório só ., blobs e blobs/sha256; o resto, arquivo comum), ou passa de $TETO_BYTES bytes extraído"
    membros=$(tar -tf "$dir/imagem.tar")
    grep -vxE '(\./)?|(\./)?(oci-layout|index\.json|blobs/?|blobs/sha256/?|blobs/sha256/[0-9a-f]{64})' <<<"$membros" >"$dir/estranhos" &&
        sair 3 "o tar foge do layout OCI (oci-layout, index.json, blobs/sha256/): $(head -c 200 "$dir/estranhos")"
    [ -z "$(sed -E 's|^\./||; s|/$||' <<<"$membros" | grep -v '^$' | sort | uniq -d)" ] ||
        sair 3 "o tar traz o mesmo membro duas vezes"
    mkdir "$dir/x"
    # O tar já foi conferido: se a extração falha, é a máquina (disco cheio).
    tar -xf "$dir/imagem.tar" -C "$dir/x" --no-same-owner --no-same-permissions ||
        sair 1 "o tar não se extraiu em $dir (disco cheio?)"
    rm -f "$dir/imagem.tar"
    if ! { [ -f "$dir/x/oci-layout" ] && [ -f "$dir/x/index.json" ] && [ -d "$dir/x/blobs" ]; }; then
        sair 3 "o tar não é um layout OCI (falta oci-layout, index.json ou blobs)"
    fi
    # -s: o arquivo inteiro, com um valor JSON só (sem ele, o -e julgaria só o
    # último de vários, e o containerd lê o primeiro).
    jq -e -s --arg id "$id" 'length == 1 and (.[0] |
        type == "object" and
        (keys - ["schemaVersion", "mediaType", "manifests"]) == [] and
        (.manifests | type) == "array" and (.manifests | length) == 1 and
        (.manifests[0] | type) == "object" and
        (.manifests[0] | keys - ["mediaType", "digest", "size", "platform"]) == [] and
        .manifests[0].digest == $id)' "$dir/x/index.json" >/dev/null 2>&1 ||
        sair 3 "o index.json do tar não é uma imagem só, sem nome, com o manifesto $id"
}

deploy() {
    local sha=$1 id=$2 tmp tam saida carregados anterior existente id_anterior
    command -v jq >/dev/null || sair 1 "o jq não está instalado (a entrada confere o tar com ele): veja docs/deploy/vps.md"
    exigir_containerd

    # Sob a trava: nenhum outro deploy está de pé. O que sobrou aqui é de um
    # deploy morto por SIGKILL (o trap não rodou).
    find "$TMP_BASE" -maxdepth 1 -name '.stillon-entrada.*' -exec rm -rf {} + || true
    tmp=$(mktemp -d "$TMP_BASE/.stillon-entrada.XXXXXX")
    TMP_DEPLOY=$tmp
    head -c $((TETO_BYTES + 1)) > "$tmp/imagem.tar"
    tam=$(stat -c %s "$tmp/imagem.tar")
    [ "$tam" -gt 0 ] || uso "nada chegou na entrada padrão (o tar do layout OCI da imagem)"
    [ "$tam" -le "$TETO_BYTES" ] || uso "a imagem passa de $TETO_BYTES bytes"

    conferir_tar "$tmp" "$id"
    # A etiqueta $IMAGEM:<sha> é o que o rollback sobe. Se ela já existe com
    # OUTRA imagem e o <sha> é um alvo do rollback (a versão no ar ou a
    # anterior), etiquetar por cima trocaria a versão boa pela nova antes do
    # healthcheck: recusa. De outro SHA (um publish refeito, uma tag v*
    # refeita, um deploy que saiu 4), a etiqueta velha é trocada. Com a mesma
    # imagem, é o redeploy e segue.
    existente=$(docker image inspect -f '{{.Id}}' "$IMAGEM:$sha" 2>/dev/null || true)
    if [ -n "$existente" ] && [ "$existente" != "$id" ]; then
        if [ "$sha" = "$(cat "$DIR/versao" 2>/dev/null || true)" ] ||
            [ "$sha" = "$(cat "$DIR/versao-anterior" 2>/dev/null || true)" ]; then
            sair 3 "$IMAGEM:$sha já existe com outra imagem ($existente), e é a versão no ar ou a anterior; o deploy pediu $id"
        fi
        echo "$IMAGEM:$sha já existe com outra imagem ($existente), fora do rollback: a etiqueta passa para $id"
    else
        existente=
    fi
    tar -cf "$tmp/refeito.tar" -C "$tmp/x" oci-layout index.json blobs ||
        sair 1 "o tar refeito não se gravou em $tmp (disco cheio?)"
    rm -rf "$tmp/x"
    saida=$(docker load -i "$tmp/refeito.tar") || sair 1 "docker load falhou"
    rm -f "$tmp/refeito.tar"
    echo "$saida"
    carregados=$(sed -n 's/^Loaded image ID: //p' <<<"$saida")
    if [ -z "$carregados" ] || [ "$(wc -l <<<"$carregados")" -ne 1 ] || grep -q '^Loaded image: ' <<<"$saida"; then
        sair 3 "o tar não trouxe exatamente uma imagem sem nome"
    fi
    if [ "$carregados" != "$id" ]; then
        # Sem etiqueta, e fora de uso: sai. Em uso ou etiquetada, o rmi recusa.
        docker rmi "$carregados" >/dev/null 2>&1 || true
        sair 3 "a imagem carregada é $carregados, e o deploy pediu $id"
    fi
    docker tag "$id" "$IMAGEM:$sha"
    # A imagem da etiqueta trocada, se ficou sem nome nenhum, sai (em uso, o
    # rmi recusa).
    if [ -n "$existente" ] && [ "$(docker image inspect -f '{{len .RepoTags}}' "$existente" 2>/dev/null)" = 0 ]; then
        docker rmi "$existente" >/dev/null 2>&1 || true
    fi

    if ! PROJETO=$(dc config --format json | jq -r .name) || [ -z "$PROJETO" ]; then
        sair 1 "o docker compose não leu o nome do projeto em $ARQUIVOS_COMPOSE"
    fi
    anterior=$(cat "$DIR/versao" 2>/dev/null || true)
    echo "deploy de $sha (antes: ${anterior:-nenhuma})"
    if subir "$sha" "$id"; then
        # 0644: não são segredo, e o dono os lê sem sudo (o umask é 077).
        echo "$sha" > "$DIR/versao.novo" && chmod 644 "$DIR/versao.novo" && mv "$DIR/versao.novo" "$DIR/versao"
        if [ -n "$anterior" ] && [ "$anterior" != "$sha" ]; then
            echo "$anterior" > "$DIR/versao-anterior.novo" && chmod 644 "$DIR/versao-anterior.novo" &&
                mv "$DIR/versao-anterior.novo" "$DIR/versao-anterior"
        fi
        { cat "$DIR/historico" 2>/dev/null || true; echo "$sha"; } | tail -n "$HISTORICO_MAX" > "$DIR/historico.novo" &&
            chmod 644 "$DIR/historico.novo" && mv "$DIR/historico.novo" "$DIR/historico"
        docker tag "$IMAGEM:$sha" "$IMAGEM:atual"
        podar
        echo "deploy de $sha saudável"
        exit 0
    fi

    echo "a pilha não ficou saudável em ${ESPERA_S} s; o log do app:"
    dc logs --no-color --tail 100 app || true
    if [ -z "$anterior" ]; then
        # Parado E removido, e conferido: o app doente fica em laço de
        # reinício (restart: unless-stopped), e o código de um `stop` nele
        # não prova que ele parou. O `compose rm -s -f` para e remove só o
        # que ficou parado: o -f dele só dispensa a confirmação, e um
        # contêiner em `restarting` conta como rodando e é pulado. O que
        # sobrar sai pelo `docker rm -f`, que mata e marca o contêiner para
        # remoção (um contêiner marcado o Docker não reinicia). O log dele já
        # ficou logo acima (e no entrada.log).
        local _ restantes
        for _ in 1 2 3; do
            dc rm -s -f app || true
            restantes=$(conteineres app) || true
            # shellcheck disable=SC2086 # um ID por palavra
            [ -z "$restantes" ] || docker rm -f $restantes >/dev/null || true
            if restantes=$(conteineres app) && [ -z "$restantes" ]; then
                sair 4 "primeiro deploy e sem versão anterior: o app ficou parado (e removido)"
            fi
            sleep 2
        done
        dc ps -a app || true
        sair 1 "primeiro deploy e sem versão anterior, e o app não saiu do ar depois de 3 tentativas: veja docs/deploy/vps.md"
    fi
    # A etiqueta atual só anda no sucesso: continua na anterior. O image-id
    # dela é o que a etiqueta $IMAGEM:<anterior> tem aqui (a poda a guarda).
    id_anterior=$(docker image inspect -f '{{.Id}}' "$IMAGEM:$anterior") ||
        sair 1 "a imagem de $anterior ($IMAGEM:$anterior) sumiu: o rollback não foi tentado; veja docs/deploy/vps.md"
    if subir "$anterior" "$id_anterior"; then
        sair 4 "rollback feito: $anterior de volta no ar; $sha não subiu"
    fi
    dc logs --no-color --tail 100 app || true
    sair 1 "o rollback para $anterior também não ficou saudável: veja docs/deploy/vps.md"
}

# Identidade privada do backup: nome, labels, nonce e imagem devem concordar.
# Um prefixo parecido, sozinho, não autoriza apagar contêiner de outro projeto.
recurso_backup_proprio() {
    local cid=$1 tipo=$2 nome raiz rotulo nonce imagem esperada
    read -r nome raiz rotulo nonce imagem esperada < <(docker inspect -f \
        '{{.Name}} {{index .Config.Labels "io.stillon.backup.raiz"}} {{index .Config.Labels "io.stillon.backup.tipo"}} {{index .Config.Labels "io.stillon.backup.nonce"}} {{.Image}} {{index .Config.Labels "io.stillon.backup.imagem"}}' "$cid" 2>/dev/null) || return 1
    [ "$raiz" = "$DIR" ] && [ "$rotulo" = "$tipo" ] && [ "$imagem" = "$esperada" ] || return 1
    [[ "$nonce" =~ ^[0-9a-f]{16}$ && "$imagem" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    case "$tipo" in
        helper) [ "$nome" = "/stillon-backup-helper-$nonce" ] ;;
        restauro) [ "$nome" = "/stillon-restauro-$nonce" ] ;;
        *) return 1 ;;
    esac
}

remover_recurso_backup() {
    local cid tipo=$2
    cid=$(docker inspect -f '{{.Id}}' "$1" 2>/dev/null) || return 0
    recurso_backup_proprio "$cid" "$tipo" || return 1
    docker rm -f -v "$cid" >/dev/null
}

limpar_dump_restauro() {
    local cid
    cid=$(docker inspect -f '{{.Id}}' "$1" 2>/dev/null) || return 0
    recurso_backup_proprio "$cid" restauro || return 1
    # Arquivos exclusivos do backup, antes de remover o contêiner: o dump
    # criado pelo helper nonroot pode ainda não pertencer ao dono do host.
    docker exec --user 0 "$cid" sh -c 'rm -f /saida/stillon.dump /saida/.stillon-snapshot.*' >/dev/null 2>&1 || true
}

recuperar_backups() {
    local tipo cid d base nonce dono
    for tipo in helper restauro; do
        for cid in $(docker ps -aq --filter "label=io.stillon.backup.raiz=$DIR" \
            --filter "label=io.stillon.backup.tipo=$tipo"); do
            recurso_backup_proprio "$cid" "$tipo" || continue
            [ "$tipo" != restauro ] || limpar_dump_restauro "$cid"
            remover_recurso_backup "$cid" "$tipo" || sair 1 "não foi possível remover recurso próprio do backup anterior"
        done
    done
    # O registro é criado ANTES do docker create/run: mesmo sem CID capturado,
    # labels+nome permitem recuperação sob a trava na entrada seguinte.
    for d in "$SHM_BASE"/stillon-backup-helper.* "$SHM_BASE"/stillon-backup.*; do
        if ! { [ -d "$d" ] && [ ! -L "$d" ] && [ -f "$d/.stillon-backup-owner" ]; }; then
            continue
        fi
        base=${d##*/}
        nonce=${base##*.}
        [[ "$nonce" =~ ^[0-9a-f]{16}$ ]] || continue
        case "$base" in "stillon-backup.$nonce" | "stillon-backup-helper.$nonce") ;; *) continue ;; esac
        dono=$(cat "$d/.stillon-backup-owner")
        [ "$dono" = "$DIR" ] || continue
        rm -rf "$d"
    done
}

# Extrai o mesmo binário da imagem local da versão aprovada, sem iniciar app.
# A tag de SHA é fixada pelo deploy; o chamador SSH não escolhe a imagem.
preparar_helper_backup() {
    local sha imagem nonce nome cid tamanho
    sha=$(cat "$DIR/versao" 2>/dev/null) || sair 1 "falta a versão aprovada para o helper do backup"
    [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || sair 1 "versão aprovada inválida para o helper do backup"
    imagem=$(docker image inspect -f '{{.Id}}' "$IMAGEM:$sha" 2>/dev/null) || \
        sair 1 "imagem local da versão aprovada ausente para o helper do backup"
    [[ "$imagem" =~ ^sha256:[0-9a-f]{64}$ ]] || sair 1 "imagem aprovada inválida para o helper do backup"
    nonce=$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')
    TMP_HELPER=$SHM_BASE/stillon-backup-helper.$nonce
    mkdir -m 0700 "$TMP_HELPER"
    printf '%s\n' "$DIR" > "$TMP_HELPER/.stillon-backup-owner"
    nome=stillon-backup-helper-$nonce
    HELPER=$nome
    printf '%s\n%s\n' "$nome" "$imagem" > "$TMP_HELPER/lease"
    docker create --pull=never --name "$nome" --cidfile "$TMP_HELPER/cid" \
        --label "io.stillon.backup.raiz=$DIR" --label io.stillon.backup.tipo=helper \
        --label "io.stillon.backup.nonce=$nonce" --label "io.stillon.backup.imagem=$imagem" \
        "$imagem" version >/dev/null || sair 1 "não foi possível criar a fonte privada do helper"
    cid=$(cat "$TMP_HELPER/cid")
    if ! { [[ "$cid" =~ ^[0-9a-f]{64}$ ]] && recurso_backup_proprio "$cid" helper; }; then
        sair 1 "fonte privada do helper inválida"
    fi
    HELPER=$cid
    docker cp "$cid:/stillon" "$TMP_HELPER/stillon" || sair 1 "não foi possível copiar o helper da imagem aprovada"
    if ! { [ -f "$TMP_HELPER/stillon" ] && [ ! -L "$TMP_HELPER/stillon" ]; }; then
        sair 1 "helper não é arquivo regular"
    fi
    tamanho=$(stat -c %s "$TMP_HELPER/stillon")
    if ! { [ "$tamanho" -gt 0 ] && [ "$tamanho" -le $((64 * 1024 * 1024)) ] &&
        [ "$(od -An -tx1 -N4 "$TMP_HELPER/stillon" | tr -d ' \n')" = 7f454c46 ]; }; then
        sair 1 "helper inválido ou maior que 64 MiB"
    fi
    chmod 0600 "$TMP_HELPER/stillon"
    remover_recurso_backup "$cid" helper || sair 1 "não foi possível remover a fonte privada do helper"
    HELPER=
}

# backup: o PostgreSQL descartável usa a mesma imagem do db, memória/tmpfs
# preservados. O helper é copiado para sua camada regular, nunca executado
# no host ou por bind de /dev/shm, e roda com UID/GID 65532 e caps efetivas zero.
backup() {
    local db ip rede img senha codigo=0 raiz_docker pct nome tmp nonce uid_host gid_host
    [ -s "$DIR/age-recipient" ] || sair 1 "falta $DIR/age-recipient (a chave PÚBLICA do age)"
    command -v age >/dev/null || sair 1 "o age não está instalado"
    if ! { [ -f "$SCRIPTS/backup/backup.sh" ] && [ -f "$SCRIPTS/backup/verificar.sql" ] && [ -f "$SCRIPTS/compose/initdb.sql" ]; }; then
        sair 1 "faltam os scripts do backup em $SCRIPTS (backup/backup.sh, backup/verificar.sql, compose/initdb.sql)"
    fi
    # A senha como o compose a lê do .env: sem o CR de um arquivo editado no
    # Windows e sem aspas em volta. Só o que não precisa de escape nem no
    # .env nem na URL do postgres (o runbook gera hex); o resto seria lido de
    # um jeito pelo compose (que interpola $) e de outro aqui: recusa.
    senha=$(sed -n 's/^STILLON_BACKUP_PASSWORD=//p' "$DIR/.env" | tail -n 1)
    senha=${senha%$'\r'}
    case "$senha" in
        \"*\" | \'*\') senha=${senha:1:${#senha}-2} ;;
    esac
    [ -n "$senha" ] || sair 1 "STILLON_BACKUP_PASSWORD vazio no $DIR/.env"
    [[ "$senha" =~ ^[A-Za-z0-9._~-]+$ ]] ||
        sair 1 "STILLON_BACKUP_PASSWORD no $DIR/.env tem caractere fora de letras, dígitos e ._~- (o compose e o backup a leriam diferente): gere com openssl rand -hex 32 (docs/deploy/vps.md)"
    db=$(dc ps -q db)
    [ -n "$db" ] || sair 1 "o serviço db não está de pé"
    rede=$(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{end}}' "$db")
    ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$db")
    img=$(docker inspect -f '{{.Image}}' "$db")

    recuperar_backups
    preparar_helper_backup
    nonce=$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')
    nome=stillon-restauro-$nonce
    RESTAURO=$nome
    tmp=$SHM_BASE/stillon-backup.$nonce
    mkdir -m 0700 "$tmp"
    TMP_BACKUP=$tmp
    printf '%s\n' "$DIR" > "$tmp/.stillon-backup-owner"
    printf '%s\n%s\n' "$nome" "$img" > "$tmp/lease"
    uid_host=$(id -u)
    gid_host=$(id -g)

    # A senha do descartável é de uso único; a do stillon_backup vai ao
    # contêiner pelo ambiente (-e NOME, sem valor), fora da linha de comando.
    export POSTGRES_PASSWORD PGPASSWORD ORIGEM_URL VOLUME_BYTES
    POSTGRES_PASSWORD=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
    PGPASSWORD=$POSTGRES_PASSWORD
    ORIGEM_URL="postgres://stillon_backup:$senha@$ip:5432/stillon?sslmode=disable"
    raiz_docker=$(docker info -f '{{.DockerRootDir}}')
    VOLUME_BYTES=$(df -B1 --output=size "$raiz_docker" | tail -n 1 | tr -d ' ')

    echo "== postgres descartável ($img) na rede $rede"
    docker run -d --pull=never --init --security-opt no-new-privileges:true \
        --name "$nome" --cidfile "$tmp/cid" --network "$rede" --memory 3g \
        --label "io.stillon.backup.raiz=$DIR" --label io.stillon.backup.tipo=restauro \
        --label "io.stillon.backup.nonce=$nonce" --label "io.stillon.backup.imagem=$img" \
        --tmpfs /var/lib/postgresql:rw,size=2g -e POSTGRES_PASSWORD \
        -v "$SCRIPTS:/deploy:ro" -v "$tmp:/saida" "$img" >/dev/null ||
        sair 1 "o postgres descartável não subiu"
    for _ in $(seq 1 60); do
        docker exec "$nome" pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1 && break
        sleep 1
    done
    docker exec "$nome" pg_isready -h 127.0.0.1 -U postgres >/dev/null || sair 1 "o postgres descartável não ficou pronto"

    docker cp "$TMP_HELPER/stillon" "$nome:/stillon" || sair 1 "não foi possível instalar o helper no descartável"
    docker exec --user 0 "$nome" chmod 0555 /stillon || sair 1 "não foi possível preparar o helper no descartável"
    # O probe usa version, já reconhecido por imagens antigas: nenhuma queda
    # acidental para configuração/boot do servidor antes de recusar protocolo.
    # timeout limita o cliente Docker; o trap remove o PG exato para matar
    # também um processo remoto do probe que sobreviva à perda desse cliente.
    if ! timeout -k 5s 30s docker exec --user 0 "$nome" env -u POSTGRES_PASSWORD /usr/local/bin/gosu 65532:65532 \
        /stillon version --backup-snapshot-protocol > "$TMP_HELPER/protocolo" 2>/dev/null; then
        sair 1 "imagem aprovada não oferece o protocolo do backup; atualize a imagem e os scripts juntos"
    fi
    cmp -s "$TMP_HELPER/protocolo" <(printf 'stillon-backup-snapshot-v1\n') || \
        sair 1 "protocolo incompatível do helper do backup"
    rm -rf "$TMP_HELPER"
    TMP_HELPER=

    # O dono do host continua dono do diretório. Só o grupo/mode permitem
    # que o helper nonroot crie o dump privado; nenhuma mudança recursiva.
    if ! { docker exec --user 0 "$nome" chgrp 65532 /saida &&
        docker exec --user 0 "$nome" chmod 0770 /saida; }; then
        sair 1 "não foi possível preparar a saída privada do helper"
    fi
    docker exec --user 0 -e ORIGEM_URL -e PGPASSWORD -e VOLUME_BYTES \
        -e SAIDA=/saida/stillon.dump -e PGHOST=127.0.0.1 -e PGPORT=5432 -e PGUSER=postgres \
        "$nome" sh /deploy/backup/backup.sh || codigo=$?
    case "$codigo" in
        0 | 4) ;;
        130 | 143) sair "$codigo" "backup interrompido" ;;
        3) sair 3 "a cópia restaurada não passou nas checagens: não há backup que sirva" ;;
        *) sair 1 "o backup.sh saiu com $codigo: não houve backup" ;;
    esac
    if ! { [ -f "$tmp/stillon.dump" ] && [ ! -L "$tmp/stillon.dump" ] && [ -s "$tmp/stillon.dump" ]; }; then
        sair 1 "o backup.sh saiu $codigo sem deixar dump regular"
    fi
    # Após Wait e antes de age no host: repassar SOMENTE o arquivo regular,
    # sem seguir symlinks ou mudar o dono da árvore montada.
    docker exec --user 0 "$nome" sh -c \
        '[ -f /saida/stillon.dump ] && [ ! -L /saida/stillon.dump ] && chown -h "$1:$2" /saida/stillon.dump && chmod 0600 /saida/stillon.dump' \
        repassar "$uid_host" "$gid_host" || sair 1 "não foi possível devolver o dump ao dono do host"

    # O disco de verdade: o sistema de arquivos dos volumes do Docker. O
    # backup.sh mede o banco contra ele; aqui, a ocupação total (imagens,
    # logs, volumes). Acima de 85%, o backup vai do mesmo jeito, com o 4.
    pct=$(df --output=pcent "$raiz_docker" | tail -n 1 | tr -dc 0-9)
    echo "disco de $raiz_docker: ${pct}% ocupado"
    if [ "$pct" -ge 85 ]; then
        echo "ERRO: o disco da VPS passou de 85%: libere espaço (docs/deploy/vps.md, disco)"
        codigo=4
    fi

    age -R "$DIR/age-recipient" < "$tmp/stillon.dump" >&3 || sair 1 "o age falhou: o backup cifrado está incompleto"
    echo "backup cifrado enviado (código $codigo)"
    exit "$codigo"
}

[ "$#" -eq 0 ] || uso "argumento na linha de comando não é aceito; o pedido vem do SSH"
pedido=${SSH_ORIGINAL_COMMAND:-}
# Só minúsculas, dígitos, ":" e espaço: nada que um shell ou o docker
# interpretem (as palavras nunca passam por eval).
case "$pedido" in
    "") uso "pedido vazio" ;;
    *[!a-z0-9:\ ]*) uso "caractere não permitido no pedido" ;;
esac
read -r -a palavras <<<"$pedido"
[ "${#palavras[@]}" -gt 0 ] || uso "pedido vazio"

case "${palavras[0]}" in
    deploy)
        [ "${#palavras[@]}" -eq 3 ] || uso "deploy leva o SHA e o image-id"
        [[ "${palavras[1]}" =~ ^[0-9a-f]{40}$ ]] || uso "SHA malformado: '${palavras[1]}'"
        [[ "${palavras[2]}" =~ ^sha256:[0-9a-f]{64}$ ]] || uso "image-id malformado: '${palavras[2]}'"
        exec 9>"$DIR/.entrada.trava"
        flock -w 600 9 || sair 1 "outra operação da entrada não terminou em 10 min"
        registrar "$pedido"
        deploy "${palavras[1]}" "${palavras[2]}"
        ;;
    backup)
        [ "${#palavras[@]}" -eq 1 ] || uso "backup não leva argumento"
        exec 9>"$DIR/.entrada.trava"
        flock -w 600 9 || sair 1 "outra operação da entrada não terminou em 10 min"
        registrar "$pedido"
        backup
        ;;
    *) uso "verbo desconhecido: '${palavras[0]}'" ;;
esac
