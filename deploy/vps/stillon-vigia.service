# /etc/systemd/system/stillon-vigia.service (Plano 11, spec §6). Disparado
# a cada minuto pelo stillon-vigia.timer; roda o /usr/local/sbin/stillon-vigia
# (deploy/vps/vigia.sh) uma vez.
[Unit]
Description=StillOn: vigia externo do /healthz público (healthchecks.io)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/stillon-vigia
# Um usuário criado só para esta execução, sem acesso ao /opt/stillon: o
# systemd (como root) lê o vigia.env (SÓ o domínio e a HC_URL, nenhum segredo
# do .env) e entrega a cópia em $CREDENTIALS_DIRECTORY.
DynamicUser=yes
LoadCredential=stillon-vigia:/opt/stillon/vigia.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# Menos que o intervalo do timer (uma execução presa não encavala na
# seguinte) e mais que o pior caso do vigia.sh, para o /fail sair antes de o
# systemd matar o serviço: 15 s do /healthz + um ping com --retry 2 e
# --retry-max-time 15 (que limita também um Retry-After do servidor): nada
# começa depois de 15 s, mais a última espera (2 s) e uma tentativa inteira
# (--max-time 8) = 15 + 15 + 2 + 8 = 40 s.
TimeoutStartSec=50
