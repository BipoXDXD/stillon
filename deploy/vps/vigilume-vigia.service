# /etc/systemd/system/vigilume-vigia.service (Plano 11, spec §6). Disparado
# a cada minuto pelo vigilume-vigia.timer; roda o /usr/local/sbin/vigilume-vigia
# (deploy/vps/vigia.sh) uma vez.
[Unit]
Description=Vigilume: vigia externo do /healthz público (healthchecks.io)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vigilume-vigia
# Um usuário criado só para esta execução, sem acesso ao /opt/vigilume: o
# systemd (como root) lê o vigia.env (SÓ o domínio e a HC_URL, nenhum segredo
# do .env) e entrega a cópia em $CREDENTIALS_DIRECTORY.
DynamicUser=yes
LoadCredential=vigilume-vigia:/opt/vigilume/vigia.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# Menos que o intervalo do timer (uma execução presa não encavala na
# seguinte) e mais que o pior caso do vigia.sh, para o /fail sair antes de o
# systemd matar o serviço: 15 s do /healthz + um ping com --max-time 8 e
# --retry 2 (3 tentativas de 8 s, mais as esperas de 1 e 2 s do curl) = 42 s.
TimeoutStartSec=50
