# Modelo do /opt/vigilume/vigia.env (Plano 11, spec §6): o que o vigia externo
# (vigilume-vigia.service, deploy/vps/vigia.sh) lê, e nada mais. SEM VALORES,
# de propósito. O arquivo de verdade é do root, modo 600, e nunca entra no git;
# o systemd o entrega ao vigia pelo LoadCredential. Nenhum segredo do .env
# vem para cá: o vigia roda curl contra hosts de fora.

# O mesmo domínio do /opt/vigilume/.env, sem https:// e sem barra.
VIGILUME_DOMINIO=

# A URL de ping do healthchecks.io.
HC_URL=
