stillon.tech {
 # Só uma conexão das faixas da Cloudflare informa o cliente, e com um único endereço IPv4 ou
 # IPv6. A regex vai sobre o placeholder, que junta cabeçalhos repetidos com vírgula: o
 # header_regexp aceitaria o pedido se só uma das linhas casasse.
 # Escopo de site: trusted_proxies é por servidor e mudaria os outros sites da 443 (ADR 041).
 @cloudflare {
  import cloudflare-ips.conf
  vars_regexp {header.CF-Connecting-IP} `^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?::[0-9A-Fa-f]{1,4}){1,6}|:(?::[0-9A-Fa-f]{1,4}){1,7}|::)$`
 }
 # `route` executa na ordem escrita, sem depender da ordenação de diretivas do Caddy: o valor
 # padrão vem antes da troca pelo IP informado.
 route {
  vars client_address {remote_host}
  vars @cloudflare client_address {header.CF-Connecting-IP}
  reverse_proxy 172.31.0.3:80 {
   header_up X-Forwarded-For {vars.client_address}
   header_up -CF-Connecting-IP
   lb_try_duration 5s
   lb_try_interval 250ms
  }
 }
}
www.stillon.tech {
 redir https://stillon.tech{uri} 308
}
