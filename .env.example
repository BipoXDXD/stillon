# Avisos por e-mail no Compose local. Ambos vazios deixam o envio desligado.
# Copie para .env (ignorado pelo Git) e preencha somente no seu computador.
# Use a chave guardada no Bitwarden e um remetente verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Remetente dos e-mails de conta (confirmação e redefinição de senha), opcional.
# Vazio, vale o EMAIL_FROM; preenchido, exige as duas de cima.
ACCOUNT_EMAIL_FROM=

# Cadastro público: o par do Turnstile da Cloudflare, as duas juntas ou nenhuma.
# O cadastro só liga com o par e o e-mail configurados. Vazias aqui, o
# compose.yaml usa as chaves de teste públicas da Cloudflare, que só servem
# para dev; as de produção ficam no Bitwarden e no Coolify, nunca no Git.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# IPs ou CIDRs da própria hospedagem que a sonda recusa (v4 e v6, separados só
# por vírgula, sem espaço, sem item vazio e sem /0), para ela não alcançar as
# portas dos outros projetos da máquina. No v6, liste a /64 roteada para a VPS
# (o prefixo que o painel mostrar), e não só o endereço: qualquer IP dela chega
# à máquina.
# Opcional em dev (localhost) e no papel api; em produção, nos papéis que
# sondam (all e prober), o boot a exige. Vazia em dev,
# o sondador registra um WARN no boot e o gauge probe_blocked_cidrs fica em 0.
PROBE_BLOCKED_CIDRS=
