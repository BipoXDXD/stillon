# Avisos por e-mail no Compose local. Ambos vazios deixam o envio desligado.
# Copie para .env (ignorado pelo Git) e preencha somente no seu computador.
# Use a chave guardada no Bitwarden e um remetente verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=

# IPs ou CIDRs da própria hospedagem que a sonda recusa (v4 e v6, separados por
# vírgula), para ela não alcançar as portas dos outros projetos da máquina.
# Opcional no Compose local; obrigatória em produção.
PROBE_BLOCKED_CIDRS=
